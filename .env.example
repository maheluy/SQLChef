# Copie para .env. Variáveis do ambiente têm precedência sobre este arquivo.

# --- Ollama (LLM local) ---
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_HOST=http://localhost:11434
# janela de contexto; o schema + exemplos ocupam ~2 mil tokens
OLLAMA_NUM_CTX=8192

# --- Agente ---
# v1 = sem exemplos | v2 = few-shot | v3 = few-shot + autocorreção
AGENT_VERSION=v3
MAX_ATTEMPTS=3
