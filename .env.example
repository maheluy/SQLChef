# Copie para .env e preencha. Variáveis do ambiente têm precedência sobre este arquivo.

# Provedor do LLM: anthropic (API) ou ollama (local)
LLM_PROVIDER=anthropic

# --- Anthropic ---
ANTHROPIC_API_KEY=
# claude-opus-5-5 | claude-sonnet-5-5 | claude-haiku-5-5
ANTHROPIC_MODEL=claude-sonnet-5-5
# low | medium | high (nível de raciocínio; afeta custo e latência)
ANTHROPIC_EFFORT=low

# --- Ollama ---
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_HOST=http://localhost:11434

# --- Agente ---
# v1 = sem exemplos | v2 = few-shot | v3 = few-shot + autocorreção
AGENT_VERSION=v3
MAX_ATTEMPTS=3
